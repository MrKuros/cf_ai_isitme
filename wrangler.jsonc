{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-isitme",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*", "/mcp", "/mcp/*", "/badge/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "UserAgent", "class_name": "UserAgent" },
      { "name": "TARGET_DO", "class_name": "TargetDO" },
      { "name": "PROBE_DO", "class_name": "ProbeDO" },
      { "name": "MCP_OBJECT", "class_name": "IsItMeMcp" },
      { "name": "PROVIDER_DO", "class_name": "ProviderDO" },
      { "name": "TRENDS_DO", "class_name": "TrendsDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserAgent", "TargetDO", "ProbeDO", "IsItMeMcp"]
    },
    { "tag": "v2", "new_sqlite_classes": ["ProviderDO"] },
    { "tag": "v3", "new_sqlite_classes": ["TrendsDO"] }
  ],
  "workflows": [
    {
      "name": "diagnose-workflow",
      "binding": "DIAGNOSE_WORKFLOW",
      "class_name": "DiagnoseWorkflow"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "isitme_checks" }
  ],
  // Email alerts stay off until this is an address on a zone with Email Routing.
  "vars": { "EMAIL_FROM": "alerts@isitme.example" },
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true }
}
